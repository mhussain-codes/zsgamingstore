# ZS Gaming Store - Server-Only Environment Configuration
# Add your Gemini API key from Google AI Studio (https://aistudio.google.com/)
# This key is only accessed on the server (in /api/chat) and is NEVER exposed to client browsers.
GEMINI_API_KEY=your_key_here

# Store Settings
NEXT_PUBLIC_STORE_NAME="ZS Gaming Store"
NEXT_PUBLIC_STORE_CURRENCY="PKR"
